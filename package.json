{
  "name": "museaic",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "npm run typecheck && npm test -- --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.98.0",
    "apple-music-native": "file:./modules/apple-music",
    "expo": "~55.0.4",
    "expo-auth-session": "~55.0.7",
    "expo-clipboard": "^55.0.13",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "^55.0.22",
    "expo-device": "^55.0.15",
    "expo-file-system": "~55.0.16",
    "expo-image-picker": "^55.0.17",
    "expo-linking": "~55.0.7",
    "expo-notifications": "^55.0.19",
    "expo-router": "~55.0.3",
    "expo-secure-store": "~55.0.8",
    "expo-status-bar": "~55.0.4",
    "expo-video-thumbnails": "~55.0.14",
    "expo-web-browser": "~55.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.16",
    "react-test-renderer": "^19.2.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test/jest.setup.ts"
    ],
    "watchman": false,
    "roots": [
      "<rootDir>/__tests__",
      "<rootDir>/app",
      "<rootDir>/components",
      "<rootDir>/hooks",
      "<rootDir>/lib",
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx",
      "**/?(*.)+(spec|test).ts",
      "**/?(*.)+(spec|test).tsx"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "types/**/*.ts",
      "!**/*.d.ts",
      "!supabase/functions/**",
      "!modules/**"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/supabase/functions/",
      "/modules/"
    ]
  }
}
