# ── Supabase ──────────────────────────────────────────────────────────────────
# Found at: Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Spotify ───────────────────────────────────────────────────────────────────
# Create an app at: https://developer.spotify.com/dashboard
# Add redirect URI: musicbridge://spotify-callback
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# ── Google / YouTube Music ────────────────────────────────────────────────────
# Create OAuth 2.0 credentials at: https://console.cloud.google.com
# Use the native client configuration expected by lib/youtubeMusic.ts
# The Google redirect is derived from the platform client/reverse-client-id in code
# Do not configure an Expo auth.expo.io web redirect URI for this flow
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# ── Apple Music ───────────────────────────────────────────────────────────────
# Requires Apple Developer account with MusicKit enabled.
# Auth uses the native iOS SKCloudServiceController — no web browser needed.
# Server-side secrets — NOT EXPO_PUBLIC_ vars. Set via Supabase CLI:
#   supabase secrets set APPLE_TEAM_ID=<team-id>
#   supabase secrets set APPLE_KEY_ID=<key-id>
#   supabase secrets set APPLE_PRIVATE_KEY="$(cat AuthKey_<key-id>.p8)"

# ── Sign-in providers ─────────────────────────────────────────────────────────
# Comma-separated list of the social providers this build offers. Each one must
# be enabled in Supabase → Authentication → Providers first, or its button will
# fail when tapped. Leave unset for email-only sign-in.
#   Apple  — enable the Sign In with Apple capability on the App ID, then add
#            the bundle id (com.techolon.musicbridge) to Supabase's authorized
#            client IDs. Native iOS needs no client secret.
#   Google — create a *Web application* OAuth client (the existing iOS client
#            cannot be used), with the Supabase callback as its redirect URI,
#            and paste its id + secret into Supabase.
# Supabase → Authentication → URL Configuration must also allow museaic://callback
EXPO_PUBLIC_AUTH_PROVIDERS=apple,google
