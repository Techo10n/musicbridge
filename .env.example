# ── Supabase ──────────────────────────────────────────────────────────────────
# Found at: Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Spotify ───────────────────────────────────────────────────────────────────
# Create an app at: https://developer.spotify.com/dashboard
# Add redirect URI: musicbridge://spotify-callback
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# ── Google / YouTube Music ────────────────────────────────────────────────────
# Create OAuth 2.0 credentials at: https://console.cloud.google.com
# Use the native client configuration expected by lib/youtubeMusic.ts
# The Google redirect is derived from the platform client/reverse-client-id in code
# Do not configure an Expo auth.expo.io web redirect URI for this flow
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# ── Apple Music ───────────────────────────────────────────────────────────────
# Requires Apple Developer account with MusicKit enabled.
# Auth uses the native iOS SKCloudServiceController — no web browser needed.
# Server-side secrets — NOT EXPO_PUBLIC_ vars. Set via Supabase CLI:
#   supabase secrets set APPLE_TEAM_ID=<team-id>
#   supabase secrets set APPLE_KEY_ID=<key-id>
#   supabase secrets set APPLE_PRIVATE_KEY="$(cat AuthKey_<key-id>.p8)"

# ── Sign-in providers ─────────────────────────────────────────────────────────
# Comma-separated list of the social providers this build offers. Each one must
# be enabled in Supabase → Authentication → Providers first, or its button will
# fail when tapped. Leave unset for email-only sign-in.
#   Apple  — enable the Sign In with Apple capability on the App ID, then add
#            the bundle id (com.techolon.musicbridge) to Supabase's authorized
#            client IDs. Native iOS needs no client secret.
#   Google — signs in through the native iOS sheet, so it needs both client
#            ids below. Nothing opens a browser, and Google's consent screen
#            shows the app's name rather than the Supabase project domain.
# Supabase → Authentication → URL Configuration must also allow museaic://callback
EXPO_PUBLIC_AUTH_PROVIDERS=apple,google

# The *web* OAuth client whose id and secret are pasted into Supabase's Google
# provider. Supabase verifies the native id token against this audience, so
# without it sign-in fails after the sheet has already succeeded. The matching
# iOS client is EXPO_PUBLIC_GOOGLE_CLIENT_ID above — the same one YouTube Music
# uses, whose reverse is the URL scheme in ios/musicbridge/Info.plist. The
# Google button is hidden unless both are set.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ── Settings destinations ─────────────────────────────────────────────────────
# Settings draws the rows below only when the matching variable is set. Leaving
# one unset hides its row, which is deliberate: a permanent row that opens
# "not currently available" reads as a broken feature rather than one that has
# not shipped yet.
#   Terms and Privacy are required before App Store submission.
#   Support address backs both Send Feedback and the account-deletion request.
#   App Store id (digits only, no "id" prefix) enables Rate the App.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_APP_STORE_ID=

# How many characters the emailed sign-in code has. Must match Supabase →
# Authentication → Providers → Email → OTP Length (6–10). A mismatch emails a
# code that does not fit the boxes and can never be submitted. Unset means 6.
EXPO_PUBLIC_OTP_LENGTH=
